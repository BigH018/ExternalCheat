  <PropertyGroup>
    <TargetName>tests</TargetName>
    <!-- doctest and nlohmann/json are third-party: on the external include path, so their warnings are off. -->
    <ExternalIncludePath>$(RepoRoot)external\doctest;$(RepoRoot)external\nlohmann;$(ExternalIncludePath)</ExternalIncludePath>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- tests/ itself is an include root too: #include "helpers/fake_memory.h" -->
      <AdditionalIncludeDirectories>$(ProjectDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Make doctest include the real <ostream>/<iosfwd> instead of forward-declaring std types itself, which
           clashes with MSVC's <string_view> when a project header includes it after doctest.h (C2660/C2027). -->
      <PreprocessorDefinitions>DOCTEST_CONFIG_USE_STD_HEADERS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
    </Link>
  </ItemDefinitionGroup>

